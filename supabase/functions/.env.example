# Copiar a supabase/functions/.env (NO se sube a git). Solo para desarrollo local.
# Secreto de al menos 32 caracteres para las claves HMAC de intentos.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUT_HMAC_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio

# Orígenes permitidos para CORS, separados por coma. Vacío = cualquiera (solo local).
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# SOLO LOCAL: permite que las pruebas fijen la IP con el header x-prueba-ip y
# que el login use la anon key cuando no hay AUTH_SECRET_KEY (el CLI local no
# usa secret keys). Nunca configurarlo como secreto del proyecto remoto.
MODO_PRUEBAS_LOCALES=true

# Secret API key sb_secret_... para login con Sb-Forwarded-For. En local puede
# quedar vacía (usa el fallback de MODO_PRUEBAS_LOCALES). OBLIGATORIA en remoto.
AUTH_SECRET_KEY=

# Agrega el header x-regalones-fuente-ip a las respuestas (fuente, no la IP).
# Útil en staging para verificar la IP; apagar en producción.
DIAGNOSTICO_IP=false

# Secreto HMAC exclusivo para recuperación de cuenta. Mínimo 32 caracteres.
RECUPERACION_HMAC_SECRET=
